---
type Props = {
  src?: string;
  alt: string;
  project: string;
  kind?: string;
};

const { src, alt, project, kind }: Props = Astro.props;
---
<div class={`thumbnail bg-base-200 ${kind ?? ""}`}>
  {src ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  ) : kind === "dataworkspace" ? (
    <div class="data-workspace" role="img" aria-label={alt}>
      <div class="data-nav"><span></span><span></span><span></span><span></span></div>
      <div class="data-main">
        <div class="data-toolbar"><strong></strong><i></i></div>
        <div class="data-grid">
          <div class="data-card large"><span></span><i></i><i></i><i></i></div>
          <div class="data-card"><span></span><i></i><i></i></div>
          <div class="data-card"><span></span><i></i><i></i></div>
        </div>
      </div>
      <div class="data-detail"><span></span><i></i><i></i><i></i></div>
    </div>
  ) : (
    <div class="placeholder" role="img" aria-label={`${project} artwork placeholder`}>
      <div class="placeholder-art" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div>
        <strong>{project}</strong>
        <small>Artwork placeholder · 4:3 recommended</small>
      </div>
    </div>
  )}
</div>

<style>
  .thumbnail{
    position:relative;
    width:100%;
    aspect-ratio:1;
    padding:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    border:1px solid color-mix(in srgb,var(--color-base-content) 8%,transparent);
    border-radius:10px;
    box-shadow:inset 0 0 0 .5px color-mix(in srgb,white 45%,transparent);
    transition:transform .2s ease,background-color .2s ease;
  }
  img{display:block;width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain;border-radius:4px}
  .thumbnail.aurora img,.thumbnail.tecan img{width:78%;height:78%}
  .data-workspace{width:min(90%,760px);aspect-ratio:16/9;display:grid;grid-template-columns:14% minmax(0,1fr) 22%;gap:1px;overflow:hidden;background:#f3ddc8;border:1px solid #edc49b;border-radius:8px;box-shadow:0 22px 50px #8a4a0e20}
  .data-nav,.data-main,.data-detail{background:#fffaf5}.data-nav{padding:8%;display:flex;flex-direction:column;gap:8%}.data-nav span{height:3%;min-height:6px;border-radius:6px;background:#f4dfca}.data-nav span:first-child{width:60%;margin-bottom:18%;background:#fc911e}
  .data-main{padding:6%}.data-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:7%}.data-toolbar strong{width:38%;height:12px;border-radius:4px;background:#252534}.data-toolbar i{width:20%;height:22px;border-radius:5px;background:#fff0df;border:1px solid #ffd0a0}
  .data-grid{display:grid;grid-template-columns:1fr 1fr;gap:5%}.data-card{min-height:64px;padding:7%;background:#fff;border:1px solid #eee1d5;border-radius:5px}.data-card.large{grid-column:1/-1;min-height:82px}.data-card span,.data-detail span{display:block;width:42%;height:7px;margin-bottom:12%;border-radius:5px;background:#fc911e}.data-card i,.data-detail i{display:block;width:100%;height:5px;margin-top:6%;border-radius:5px;background:#f1e4d8}.data-card i:last-child{width:64%}
  .data-detail{padding:12% 10%}.data-detail span{width:58%;background:#252534}.data-detail i:nth-of-type(2){width:74%}.data-detail i:nth-of-type(3){width:88%}
  .placeholder{
    width:min(78%,520px);
    aspect-ratio:4/3;
    padding:clamp(1.25rem,3vw,2rem);
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    color:color-mix(in srgb,var(--color-base-content) 55%,transparent);
    background:var(--color-base-100);
    border:1px dashed color-mix(in srgb,var(--color-base-content) 20%,transparent);
    border-radius:6px;
  }
  .placeholder-art{display:grid;grid-template-columns:1.5fr 1fr;grid-template-rows:1fr 1fr;gap:8px;flex:1;margin-bottom:1.25rem}
  .placeholder-art span{display:block;border-radius:3px;background:color-mix(in srgb,var(--color-base-content) 6%,transparent)}
  .placeholder-art span:first-child{grid-row:1/3}.placeholder-art span:last-child{background:color-mix(in srgb,var(--color-primary) 24%,var(--color-base-100))}
  .placeholder strong{display:block;font:400 1.05rem/1.2 Georgia,serif;color:color-mix(in srgb,var(--color-base-content) 78%,transparent)}
  .placeholder small{display:block;margin-top:.25rem;font-size:.68rem;letter-spacing:.01em}
  @media(max-width:720px){.thumbnail{padding:24px}.thumbnail.aurora img,.thumbnail.tecan img{width:84%;height:84%}.placeholder{width:88%}.data-workspace{width:100%;grid-template-columns:16% minmax(0,1fr)}.data-detail{display:none}}
</style>
