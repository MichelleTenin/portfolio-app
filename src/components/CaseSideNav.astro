---
type Section = { id: string; label: string };

const { sections }: { sections: Section[] } = Astro.props;

const sectionIds = JSON.stringify(sections.map((section) => section.id));
---

<aside class="case-side-nav" aria-label="Case study navigation">
  <a class="case-home" href="/#work">← Home</a>

  <div class="anchor-nav">
    <div class="side-track" aria-hidden="true"><span></span></div>
    <ol data-case-nav data-sections={sectionIds}>
      {sections.map((section) => (
        <li><a href={`#${section.id}`}>{section.label}</a></li>
      ))}
    </ol>
  </div>
</aside>

<style>
  .case-side-nav{position:sticky;top:4rem;align-self:start;width:180px;padding-top:3.5rem}
  .case-home{display:inline-block;margin-bottom:1.5rem;font-size:.72rem;font-weight:600;color:color-mix(in srgb,var(--ink) 58%,transparent);text-decoration:none;transition:color .15s}
  .case-home:hover{color:var(--ink)}
  .anchor-nav{display:flex;gap:.75rem}
  .side-track{position:relative;width:1.5px;flex:0 0 auto;background:color-mix(in srgb,var(--ink) 8%,transparent);border-radius:2px}
  .side-track span{position:absolute;top:0;left:0;width:1.5px;height:12px;background:var(--ink);border-radius:2px;transition:transform .25s ease}
  ol{list-style:none;margin:0;padding:0}li{margin:0}
  ol a{display:block;padding:2px 0;font-size:.72rem;line-height:1.4rem;text-decoration:none;color:color-mix(in srgb,var(--ink) 32%,transparent);transition:color .2s}
  ol a[aria-current]{color:var(--ink);font-weight:650}
  @media(max-width:1100px){.case-side-nav{display:none}}
</style>
