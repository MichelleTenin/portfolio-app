---
import MainLayout from "../layouts/MainLayout.astro";
import CSHero from "./CSHero.astro";

const { project } = Astro.props;
const isStructuredLayout =
  project.layout === "aurora" ||
  project.layout === "tecan" ||
  project.layout === "dataworkspace";
const sections = isStructuredLayout
  ? [
      { id: "overview", label: "Overview" },
      { id: "challenge", label: "The challenge" },
      { id: "process", label: "The process" },
      { id: "solution", label: "The solution" },
      { id: "reflection", label: "The reflection" },
    ]
  : [
      { id: "overview", label: "Overview" },
      { id: "challenge", label: "The challenge" },
      { id: "approach", label: "The approach" },
      ...(project.gallery?.length ? [{ id: "artifacts", label: "Process & artifacts" }] : []),
      { id: "outcome", label: "Outcome" },
      { id: "reflection", label: "Reflection" },
    ];
const sectionIds = JSON.stringify(sections.map((section) => section.id));
---
<MainLayout title={`${project.title} — Michelle Tenin`}>
  <div class="case-layout shell">
    <aside class="side-nav" aria-label="Case study sections">
      <div class="side-track" aria-hidden="true"><span></span></div>
      <ol data-case-nav data-sections={sectionIds}>
        {sections.map((section) => (
          <li><a href={`#${section.id}`}>{section.label}</a></li>
        ))}
      </ol>
    </aside>

    <div class="case-column">
      <CSHero {...project} />

      <article class="story">
        <section id="challenge">
          <div class="section-heading"><span>The challenge</span><i></i></div>
          <h2 class="display">{project.challengeTitle}</h2>
          <p>{project.challenge}</p>
          {project.challengeItems?.length > 0 && (
            <ul class="challenge-list">
              {project.challengeItems.map((item) => <li>{item}</li>)}
            </ul>
          )}
          {project.quote && <blockquote>“{project.quote}”</blockquote>}
          {project.designPrompt && <blockquote class="design-prompt"><strong>Design prompt:</strong> {project.designPrompt}</blockquote>}
          {project.challengeMedia && (
            <figure class="challenge-media">
              <img src={project.challengeMedia} alt="The care cliff between cancer treatment and survivorship" loading="lazy" />
            </figure>
          )}
        </section>

        <section id={isStructuredLayout ? "process" : "approach"}>
          <div class="section-heading"><span>{isStructuredLayout ? "The process" : "The approach"}</span><i></i></div>
          <h2 class="display">{project.approachTitle}</h2>
          <p>{project.approach}</p>
          <div class="principles">
            {project.principles?.map((principle) => (
              <div class="card bg-base-200"><span>✦</span><strong>{principle}</strong></div>
            ))}
          </div>
          {project.personas?.length > 0 && (
            <div class="persona-grid">
              {project.personas.map((persona) => (
                <article class="persona-card card bg-base-100">
                  <header>
                    <img src={persona.image} alt="" loading="lazy" />
                    <div>
                      <h3>{persona.name} <span>({persona.age})</span></h3>
                      <p>{persona.role}</p>
                    </div>
                  </header>
                  <p>{persona.bio}</p>
                  <div class="persona-detail">
                    <strong>Goal</strong>
                    <p>{persona.goal}</p>
                  </div>
                  <div class="persona-detail">
                    <strong>Frustrations</strong>
                    <ul>{persona.frustrations.map((item) => <li>{item}</li>)}</ul>
                  </div>
                </article>
              ))}
            </div>
          )}
          {project.processNotes?.length > 0 && (
            <div class="process-notes">
              {project.processNotes.map((note) => (
                <div>
                  <h3>{note.title}</h3>
                  <p>{note.copy}</p>
                </div>
              ))}
            </div>
          )}
          {project.processMedia?.length > 0 && (
            <div class="media-grid process-media">
              {project.processMedia.map((src, index) => (
                <figure>
                  <img src={src} alt={`${project.title} research process ${index + 1}`} loading="lazy" />
                </figure>
              ))}
            </div>
          )}
        </section>

        {isStructuredLayout ? (
          <section id="solution">
            <div class="section-heading"><span>The solution</span><i></i></div>
            <h2 class="display">{project.solutionTitle}</h2>
            <p>{project.solution}</p>
            {project.solutionFeatures?.length > 0 && (
              <ul class="solution-features">
                {project.solutionFeatures.map((feature) => <li>{feature}</li>)}
              </ul>
            )}
            {project.solutionMedia && (
              <figure class="solution-media">
                <img src={project.solutionMedia} alt={project.solutionMediaAlt ?? `${project.title} solution`} loading="lazy" />
              </figure>
            )}
          </section>
        ) : project.gallery?.length > 0 && (
          <section id="artifacts">
            <div class="section-heading"><span>Process & artifacts</span><i></i></div>
            <div class="gallery">
              {project.gallery.map((src, index) => (
                <figure>
                  <img src={src} alt={`${project.title} process artifact ${index + 1}`} loading="lazy" />
                </figure>
              ))}
            </div>
          </section>
        )}

        {!isStructuredLayout && (
          <section id="outcome">
            <div class="section-heading"><span>Outcome</span><i></i></div>
            <div class={`outcome card bg-primary ${project.kind}`}>
              <p class="display">{project.outcome}</p>
            </div>
          </section>
        )}

        <section id="reflection">
          <div class="section-heading"><span>{isStructuredLayout ? "The reflection" : "Reflection"}</span><i></i></div>
          <h2 class="display">{project.reflectionTitle ?? "Clarity is a product feature."}</h2>
          {project.reflection?.length > 0
            ? project.reflection.map((paragraph) => <p>{paragraph}</p>)
            : <p>{project.learning}</p>}
          {project.reflectionMedia?.length > 0 && (
            <div class="media-grid reflection-media">
              {project.reflectionMedia.map((src, index) => (
                <figure>
                  <img src={src} alt={index === 0 ? "Aurora project team" : "Presenting the Aurora project at Artefact Studio"} loading="lazy" />
                </figure>
              ))}
            </div>
          )}
        </section>

        <nav class="next">
          <a href="/">← All projects</a>
          <a href={project.nextHref}>Next: {project.next} →</a>
        </nav>
      </article>
    </div>
  </div>
</MainLayout>

<script>
  const nav = document.querySelector<HTMLOListElement>("[data-case-nav]");
  if (nav) {
    const ids: string[] = JSON.parse(nav.dataset.sections ?? "[]");
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("a"));
    const indicator = nav.parentElement?.querySelector<HTMLElement>(".side-track span");

    const activate = (id: string) => {
      links.forEach((link) => link.toggleAttribute("aria-current", link.hash === `#${id}`));
      const active = links.find((link) => link.hash === `#${id}`);
      if (active && indicator) {
        const item = active.closest("li");
        if (!item) return;

        const listRect = nav.getBoundingClientRect();
        const itemRect = item.getBoundingClientRect();
        const itemTop = itemRect.top - listRect.top;
        const centeredTop =
          itemTop + (itemRect.height - indicator.offsetHeight) / 2;

        indicator.style.transform = `translateY(${centeredTop}px)`;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (visible) activate(visible.target.id);
      },
      { rootMargin: "-15% 0px -65% 0px" }
    );

    ids.forEach((id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
    activate(ids[0]);
  }
</script>

<style>
  .case-layout{position:relative;display:grid;grid-template-columns:180px minmax(0,48rem) 180px;justify-content:center;gap:2.5rem}
  .case-column{grid-column:2;min-width:0}
  .side-nav{position:sticky;top:9rem;align-self:start;display:flex;gap:.75rem;padding-top:1rem}
  .side-track{position:relative;width:1.5px;background:color-mix(in srgb,var(--ink) 8%,transparent);border-radius:2px}
  .side-track span{position:absolute;top:0;left:0;width:1.5px;height:12px;background:var(--ink);border-radius:2px;transition:transform .25s ease}
  .side-nav ol{list-style:none;margin:0;padding:0}.side-nav li{margin:0}.side-nav a{display:block;padding:2px 0;font-size:.75rem;line-height:1.45rem;text-decoration:none;color:color-mix(in srgb,var(--ink) 32%,transparent);transition:color .2s}
  .side-nav a[aria-current]{color:var(--ink);font-weight:650}
  .story section{scroll-margin-top:2rem;padding:4rem 0 0}
  .section-heading{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem;font-size:.82rem;font-weight:650;color:color-mix(in srgb,var(--ink) 78%,transparent)}
  .section-heading i{display:block;flex:1;height:1px;background:color-mix(in srgb,var(--ink) 8%,transparent)}
  .story h2{font-size:1.55rem;line-height:1.4;letter-spacing:-.02em;margin:.25rem 0 1rem}
  .story section>p{font-size:.9rem;line-height:1.55rem;margin:.65rem 0;max-width:44rem}
  blockquote{margin:1.75rem 0 0;padding:1rem 1.25rem;border-left:2px solid var(--primary,var(--yellow));background:var(--color-base-200);font:400 1.1rem/1.55 Georgia,serif}
  .challenge-list{margin:1.25rem 0 0;padding-left:1.25rem;display:grid;gap:.45rem;font-size:.86rem;line-height:1.4}.design-prompt{font-size:1rem}.design-prompt strong{font:650 .7rem/1.4 var(--font-sans,Arial,sans-serif);text-transform:uppercase;letter-spacing:.04em}
  .principles{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin-top:1.5rem}
  .principles>div{min-height:110px;padding:1rem;display:flex;flex-direction:column;justify-content:space-between;border:1px solid color-mix(in srgb,var(--ink) 6%,transparent);box-shadow:none}
  .principles span{color:var(--coral)}.principles strong{font-size:.8rem}
  .principles:empty{display:none}
  .persona-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-top:1.75rem}
  .persona-card{padding:1rem;border:1px solid color-mix(in srgb,var(--ink) 8%,transparent);box-shadow:none}
  .persona-card header{display:flex;align-items:center;gap:.75rem;padding-bottom:.9rem;border-bottom:1px solid color-mix(in srgb,var(--ink) 8%,transparent)}
  .persona-card header img{width:44px;height:44px;flex:0 0 auto;object-fit:cover;border-radius:50%;border:1px solid color-mix(in srgb,var(--ink) 8%,transparent)}
  .persona-card h3{margin:0;font-size:.82rem}.persona-card h3 span{font-weight:450;color:var(--muted)}.persona-card header p{margin:.15rem 0 0;font-size:.66rem;color:var(--muted)}
  .persona-card>p{margin:.9rem 0;font-size:.72rem;line-height:1.25rem;color:color-mix(in srgb,var(--ink) 72%,transparent)}
  .persona-detail{margin-top:.8rem}.persona-detail strong{font-size:.62rem;text-transform:uppercase;letter-spacing:.04em}.persona-detail p,.persona-detail ul{margin:.3rem 0 0;font-size:.68rem;line-height:1.15rem}.persona-detail ul{padding-left:1rem;display:grid;gap:.25rem}
  .process-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid color-mix(in srgb,var(--ink) 8%,transparent)}.process-notes h3{margin:0 0 .45rem;font-size:.76rem;text-transform:capitalize}.process-notes p{margin:0;font-size:.72rem;line-height:1.3rem;color:color-mix(in srgb,var(--ink) 72%,transparent)}
  .challenge-media,.solution-media{margin:2rem 0 0;padding:1.5rem;display:flex;justify-content:center;background:var(--color-base-200);border:1px solid color-mix(in srgb,var(--ink) 6%,transparent);border-radius:var(--radius-box);overflow:hidden}
  .challenge-media img{display:block;width:min(100%,560px);height:auto;max-height:420px;object-fit:contain}
  .solution-media{background:#fff}.solution-media img{display:block;width:min(100%,620px);height:auto;object-fit:contain}
  .solution-features{margin:1.25rem 0 0;padding-left:1.25rem;display:grid;gap:.55rem;font-size:.86rem;line-height:1.45}
  .media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:1.5rem}
  .media-grid figure{margin:0;overflow:hidden;background:var(--color-base-200);border-radius:var(--radius-box)}
  .media-grid img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}
  .gallery{display:flex;flex-direction:column;gap:.75rem}.gallery figure{margin:0;background:var(--color-base-200);border-radius:var(--radius-box);overflow:hidden}.gallery img{display:block;width:100%;height:auto;max-height:680px;object-fit:contain}
  .outcome{padding:2rem;border-radius:var(--radius-box);box-shadow:none}.outcome p{font-size:clamp(1.8rem,4vw,2.7rem);line-height:1.12;margin:0;max-width:650px}
  .next{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid color-mix(in srgb,var(--ink) 8%,transparent);margin-top:4rem;padding:1.5rem 0 2rem}.next a{font-size:.78rem;color:var(--muted);text-decoration:none}
  @media(max-width:1100px){
    .case-layout{display:block;width:min(48rem,calc(100% - 48px))}
    .side-nav{display:none}
  }
  @media(max-width:640px){
    .case-layout{width:min(100% - 28px,48rem)}.principles,.media-grid,.persona-grid,.process-notes{grid-template-columns:1fr}.story section{padding-top:3rem}.outcome{padding:1.5rem}.challenge-media,.solution-media{padding:1rem}
  }
</style>
