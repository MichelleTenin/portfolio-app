---
import { Image } from "astro:assets";
import SiteLogo from "../assets/Michelle-Logo-2026.svg";
import HamburgerClosed from "../assets/hamburger-closed.png";
import HamburgerOpen from "../assets/hamburger-open.png";
const path = Astro.url.pathname;
const projects = [
  { href: "/unified-data-workspace", title: "Data Platform Hub", description: "SW Infra @ Nvidia", mark: "dataworkspace" },
  { href: "/aurora", title: "Cancer Survivorship Support", description: "Design for America @ UW", mark: "aurora" },
  { href: "/tecan", title: "Digital Visual Factory", description: "Medtech manufacturing @ Tecan", mark: "tecan" },
  { href: "/teststudio", title: "Behavioral Testing", description: "Autonomous Vehicles @ Nvidia", mark: "testing" },
  { href: "/mlloop", title: "Corner Case Management", description: "MLOps @ Nvidia", mark: "mlops" },
];
const workIsActive = projects.some(({ href }) => path === href);
---
<header class="nav-wrap">
  <nav class="shell nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Michelle Tenin, home">
      <Image src={SiteLogo} alt="" width={44} height={19} />
    </a>
    <button
      class="menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <Image class="menu-icon closed-icon" src={HamburgerClosed} alt="" width={20} height={20} />
      <Image class="menu-icon open-icon" src={HamburgerOpen} alt="" width={20} height={20} />
    </button>
    <div id="nav-links" class="nav-links">
      <div class="work-dropdown">
        <button
          class:list={["work-button", { active: workIsActive }]}
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="work-menu"
        >
          Work
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2.5 4 5 6.5 7.5 4"></path>
          </svg>
        </button>
        <div id="work-menu" class="work-menu" role="menu" aria-hidden="true">
          <div class="work-menu-inner">
            {projects.map((project) => (
              <a href={project.href} role="menuitem" tabindex="-1">
                <span class={`project-mark ${project.mark}`} aria-hidden="true">
                  <i></i>
                </span>
                <span>
                  <strong>{project.title}</strong>
                  <small>{project.description}</small>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <a class:list={["nav-item", {active: path === "/about"}]} href="/about">About</a>
      <div class="contact-dropdown">
        <button
          class="contact-button"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="contact-menu"
        >
          Contact
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2.5 4 5 6.5 7.5 4"></path>
          </svg>
        </button>
        <div id="contact-menu" class="contact-menu" role="menu" aria-hidden="true">
          <div class="contact-menu-inner">
            <a href="mailto:mtenin3@gmail.com" role="menuitem" tabindex="-1">
              <span class="contact-mark email" aria-hidden="true">@</span>
              <span><strong>Email</strong><small>Shoot me a message</small></span>
            </a>
            <a href="https://www.linkedin.com/in/michelle-tenin-631019173" role="menuitem" tabindex="-1">
              <span class="contact-mark linkedin" aria-hidden="true">in</span>
              <span><strong>LinkedIn</strong><small>Let’s connect</small></span>
            </a>
            <a href="https://drive.google.com/file/d/1eiaOI0Iv4D8ehYo9i_TyhKwAUlziBgl9/view" role="menuitem" tabindex="-1">
              <span class="contact-mark resume" aria-hidden="true">CV</span>
              <span><strong>Résumé</strong><small>View PDF</small></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const links = document.querySelector<HTMLElement>(".nav-links");
  const workDropdown = document.querySelector<HTMLElement>(".work-dropdown");
  const workButton = document.querySelector<HTMLButtonElement>(".work-button");
  const workMenu = document.querySelector<HTMLElement>(".work-menu");
  const workMenuLinks = workMenu?.querySelectorAll<HTMLAnchorElement>("a");
  const contactDropdown = document.querySelector<HTMLElement>(".contact-dropdown");
  const contactButton = document.querySelector<HTMLButtonElement>(".contact-button");
  const contactMenu = document.querySelector<HTMLElement>(".contact-menu");
  const contactMenuLinks = contactMenu?.querySelectorAll<HTMLAnchorElement>("a");

  const setWorkMenu = (open: boolean) => {
    workDropdown?.classList.toggle("open", open);
    workButton?.setAttribute("aria-expanded", String(open));
    workMenu?.setAttribute("aria-hidden", String(!open));
    workMenuLinks?.forEach((link) => link.setAttribute("tabindex", open ? "0" : "-1"));
  };
  const setContactMenu = (open: boolean) => {
    contactDropdown?.classList.toggle("open", open);
    contactButton?.setAttribute("aria-expanded", String(open));
    contactMenu?.setAttribute("aria-hidden", String(!open));
    contactMenuLinks?.forEach((link) => link.setAttribute("tabindex", open ? "0" : "-1"));
  };

  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    button.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    links?.classList.toggle("open");
    if (open) {
      setWorkMenu(false);
      setContactMenu(false);
    }
  });
  workButton?.addEventListener("click", (event) => {
    event.stopPropagation();
    setContactMenu(false);
    setWorkMenu(workButton.getAttribute("aria-expanded") !== "true");
  });
  contactButton?.addEventListener("click", (event) => {
    event.stopPropagation();
    setWorkMenu(false);
    setContactMenu(contactButton.getAttribute("aria-expanded") !== "true");
  });
  document.addEventListener("click", (event) => {
    if (!workDropdown?.contains(event.target as Node)) setWorkMenu(false);
    if (!contactDropdown?.contains(event.target as Node)) setContactMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      const contactWasOpen = contactButton?.getAttribute("aria-expanded") === "true";
      const workWasOpen = workButton?.getAttribute("aria-expanded") === "true";
      setWorkMenu(false);
      setContactMenu(false);
      if (contactWasOpen) contactButton?.focus();
      else if (workWasOpen) workButton?.focus();
    }
  });
</script>
<style>
  .nav-wrap { position: sticky; top: 0; z-index: 50; padding: 10px 0 0; pointer-events: none; }
  .nav { width: min(820px, calc(100% - 28px)); height: 54px; padding: 0 18px; display: flex; align-items: center; justify-content: space-between; pointer-events: auto; background: color-mix(in srgb, var(--color-base-100) 88%, transparent); border: 1px solid color-mix(in srgb, var(--color-base-content) 9%, transparent); border-radius: 999px; backdrop-filter: blur(14px); box-shadow: 0 4px 18px color-mix(in srgb, var(--color-base-content) 5%, transparent); }
  .brand { display: flex; align-items: center; text-decoration: none; }
  .brand img { width: 44px; height: auto; object-fit: contain; }
  .nav-links { display: flex; gap: 1rem; align-items: center; }
  .nav-item,.work-button,.contact-button { height: 32px; padding: 0 .75rem; display: flex; align-items: center; color:color-mix(in srgb,var(--color-base-content) 55%,transparent); background:none; border:0; border-radius:8px; font:450 .75rem/1 inherit; text-decoration:none; cursor:pointer; transition:color .15s ease,background-color .15s ease,transform .1s ease; }
  .work-button,.contact-button{gap:.3rem}
  .nav-item:hover,.nav-item:focus-visible,.work-button:hover,.work-button:focus-visible,.contact-button:hover,.contact-button:focus-visible,.work-dropdown.open .work-button,.contact-dropdown.open .contact-button{color:color-mix(in srgb,var(--color-base-content) 85%,transparent);background:var(--color-base-200)}
  .nav-item:active,.work-button:active,.contact-button:active{transform:scale(.97)}
  .nav-item.active,.work-button.active{color:var(--color-base-content);background:var(--color-base-200)}
  .work-dropdown,.contact-dropdown { position: relative; }
  .work-button svg,.contact-button svg { transition: transform .18s ease; }
  .work-button path,.contact-button path { stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .work-dropdown.open .work-button svg,.contact-dropdown.open .contact-button svg { transform: rotate(180deg); }
  .work-menu,.contact-menu { position: absolute; top: calc(100% + 8px); right: 0; width: 280px; padding: 8px; visibility: hidden; opacity: 0; pointer-events: none; transform: translateY(-8px); background: var(--color-base-100); border-radius: 12px; box-shadow: 0 14px 36px color-mix(in srgb, var(--color-base-content) 12%, transparent); transition: opacity .16s ease, transform .16s ease, visibility .16s; }
  .work-dropdown.open .work-menu,.contact-dropdown.open .contact-menu { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0); }
  .work-menu-inner,.contact-menu-inner { display: grid; gap: 2px; }
  .work-menu a,.contact-menu a { padding: 8px; display: flex; align-items: center; gap: 12px; border-radius: 9px; text-decoration:none; }
  .work-menu a:hover,.work-menu a:focus-visible,.contact-menu a:hover,.contact-menu a:focus-visible { background: var(--color-base-200); outline: none; }
  .work-menu a > span:last-child,.contact-menu a > span:last-child { min-width: 0; }
  .work-menu strong,.work-menu small,.contact-menu strong,.contact-menu small { display: block; }
  .work-menu strong,.contact-menu strong { margin-bottom: 3px; color: color-mix(in srgb, var(--color-base-content) 88%, transparent); font-size: .78rem; line-height: 1.1; }
  .work-menu small,.contact-menu small { overflow: hidden; color: color-mix(in srgb, var(--color-base-content) 48%, transparent); font-size: .68rem; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .project-mark,.contact-mark { position: relative; width: 56px; height: 56px; flex: 0 0 auto; display: grid; place-items: center; overflow: hidden; background: var(--color-base-200); border: 1px solid color-mix(in srgb, var(--color-base-content) 7%, transparent); border-radius: 9px; }
  .project-mark i { width: 19px; height: 19px; display: block; border: 1.5px solid currentColor; }
  .project-mark.aurora { color: #8e4ec6; background: #f3e7fa; }
  .project-mark.aurora i { border-radius: 50% 50% 45% 55%; transform: rotate(45deg); }
  .project-mark.tecan { color: #2870bd; background: #e1f0ff; }
  .project-mark.tecan i { border-radius: 3px; box-shadow: 5px 5px 0 -1px currentColor; transform: translate(-2px, -2px); }
  .project-mark.testing { color: #d15f24; background: #ffead5; }
  .project-mark.testing i { border-radius: 50%; border-style: dashed; }
  .project-mark.mlops { color: #36865f; background: #dff3e7; }
  .project-mark.mlops i { border-radius: 2px; transform: rotate(45deg); }
  .project-mark.dataworkspace { color: #fc911e; background: #fff0df; }
  .project-mark.dataworkspace i { border-radius: 50%; box-shadow: 8px 0 0 -3px currentColor, -8px 0 0 -3px currentColor; }
  .contact-mark{font-weight:650;color:color-mix(in srgb,var(--color-base-content) 58%,transparent)}
  .contact-mark.email{background:#dff3e7;color:#36865f;font-size:1rem}
  .contact-mark.linkedin{background:#e1f0ff;color:#2870bd;font-family:Arial,sans-serif;font-size:.9rem}
  .contact-mark.resume{background:#f3e7fa;color:#8e4ec6;font-size:.65rem;letter-spacing:.04em}
  .menu-button { display: none; width: 30px; height: 30px; padding: 5px; place-items: center; background: none; border: 0; border-radius: 8px; cursor: pointer; transition: background-color .15s ease, transform .12s ease; }
  .menu-button:hover, .menu-button:focus-visible { background: var(--color-base-200); }
  .menu-button:active { transform: scale(.95); }
  .menu-icon { display: block; width: 20px; height: 20px; object-fit: contain; }
  .open-icon { display: none; }
  .menu-button[aria-expanded="true"] .closed-icon { display: none; }
  .menu-button[aria-expanded="true"] .open-icon { display: block; }
  @media (max-width: 640px) {
    .menu-button { display: grid; }
    .nav { padding: 0 12px 0 14px; }
    .nav-links { display: none; position: absolute; top: 70px; left: 14px; right: 14px; flex-direction: column; align-items: stretch; gap:.5rem; padding: 1rem; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 18px 30px #25201518; }
    .nav-links.open { display: flex; }
    .nav-item,.work-button,.contact-button { width: 100%; justify-content: space-between; padding:0 .5rem; }
    .work-menu,.contact-menu { position: static; width: 100%; max-height: 0; padding: 0; overflow: hidden; box-shadow: none; transform: none; transition: max-height .2s ease, opacity .15s ease; }
    .work-dropdown.open .work-menu { max-height: 330px; padding-top: 8px; }
    .contact-dropdown.open .contact-menu { max-height: 250px; padding-top: 8px; }
  }
</style>
