---
import CaseStudy from "../components/CaseStudy.astro";
import { assets } from "../data/assets";
const project = {
  number:"02", title:"Tecan", headline:"A visual factory for Tecan’s production line.", breadcrumb:"Medtech Manufacturing / Tecan", kind:"tecan", cover:assets.tecan.cover, layout:"tecan", kicker:"Research · Usability testing · IA", role:"Product designer", duration:"Oct 2019—Oct 2020",
  sections:[
    { id:"overview", label:"Context" },
    { id:"challenge", label:"Production gap" },
    { id:"process", label:"Floor research" },
    { id:"solution", label:"Visual factory" },
    { id:"reflection", label:"Takeaways" },
  ],
  excerpt:"At Tecan Group, a global laboratory automation company, I worked directly with production personnel and manufacturing engineers to study factory-floor workflows, translate CAD drawings into digital assembly instructions, and test a Visual Factory platform for greater efficiency, traceability, and consistency.",
  challengeTitle:"Paper instructions could not keep pace with the line.",
  challenge:"Production lines relied heavily on printed instructions and manual verification, leading to inconsistencies and delays. Operators had developed informal methods over time, creating variations in assembly accuracy and documentation.",
  challengeItems:["Inconsistent operator methods","Paper-based verification added friction","Outdated hard-copy instructions","Limited checkpoints for accountability"],
  callout:"How might digital line tracing and visual guidance reduce production errors while improving efficiency?",
  approachTitle:"Design from the production floor out.",
  approach:"Research began on the production floor: shadowing operators, conducting informal interviews, and testing prototypes directly with the people assembling laboratory automation systems.",
  personas:[
    {
      name:"William", role:"Manufacturing Engineer", image:assets.tecan.personas.william,
      bio:"In his second year at the company, William supports multiple production lines. Updated work instructions are the last thing on his mind while he puts out fires on the floor.",
      goal:"Minimize production errors.",
      frustrations:["Separate instruction documents are difficult to maintain","Production and operator accountability are hard to track","Assembly errors lower output per line"],
    },
    {
      name:"Frank", role:"Inexperienced Operator", image:assets.tecan.personas.frank,
      bio:"New to the production floor, Frank has basic tool-handling experience and needs to move slowly through unfamiliar, customer-specific builds.",
      goal:"Learn the assembly process with minimal confusion and errors.",
      frustrations:["Language barriers","Unfamiliar assembly processes","Flipping through instructions takes too long"],
    },
    {
      name:"Kim", role:"Experienced Operator", image:assets.tecan.personas.kim,
      bio:"Kim has years of experience across multiple lines and products. She uses batch-style assembly and rarely opens the dense work instructions.",
      goal:"Work quickly and error-free while understanding the current build.",
      frustrations:["Too much production paperwork","Needs to move quickly through assembly","Dense and unreliable work instructions"],
    },
  ],
  processNotes:[
    { title:"Research & discovery", copy:"Direct observation exposed how operators adapted instructions, tools, and verification steps under real production pressure." },
    { title:"Design & iteration", copy:"Early iterations focused on digitizing the most error-prone steps and streamlining verification. The Visual Factory platform integrated digital instructions, embedded CAD visuals, and real-time checkpoints to improve traceability." },
    { title:"Remote collaboration", copy:"When COVID-19 limited direct user access, observational data and iterative reviews with the Manufacturing Engineering Manager guided refinements to usability and flow." },
  ],
  solutionTitle:"Interactive instructions made the assembly process visible.",
  solution:"The redesigned Visual Factory replaced static documents with interactive digital instructions that provided visual cues, progress tracking, and clearer accountability.",
  solutionFeatures:["Modular instruction flow by assembly step","Embedded CAD visuals for context","Built-in verification checkpoints to reduce batching errors"],
  solutionMedia:assets.tecan.visualFactory,
  solutionMediaAlt:"Visual Factory interface showing digital assembly instructions and verification controls",
  reflectionTitle:"Proximity, adaptability, and visual clarity.",
  reflection:[
    "The work at Tecan bridged user research and manufacturing design in a technical, high-stakes production environment.",
    "The project reinforced the importance of proximity to users, adaptability when access is limited, and visual clarity when instructions shape physical work.",
    "Supporting a company that equipped medical labs during COVID-19 underscored how thoughtful systems design can create tangible impact.",
  ],
  prev:"Cancer Survivorship Support", prevHref:"/aurora",
