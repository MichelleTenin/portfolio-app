---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectThumbnail from "../components/ProjectThumbnail.astro";
import { assets } from "../data/assets";
const projects = [
  { href:"/unified-data-workspace", kind:"dataworkspace", image:assets.home.dataPlatformHubThumbnail, title:"Data Platform Hub", descriptor:"SW Infra / NVIDIA", copy:"Defining the problem space and product strategy for a single place to navigate, understand, and interact with complex structured data.", class:"featured" },
  { href:"/mlloop", kind:"mlloop", image:assets.home.mlLoopThumbnail, title:"Closing the ML Data Loop", descriptor:"AV MLOps / NVIDIA", copy:"Turning isolated model failures into a trackable, scenario-centered data improvement lifecycle.", class:"featured" },
  { href:"/aurora", kind:"aurora", image:assets.home.auroraThumbnail, title:"Cancer Survivorship Support", descriptor:"DFA / University of Washington", copy:"Bridging the gap between treatment and survivorship through a compassionate, hospital-based support system.", class:"supporting" },
  { href:"/tecan", kind:"tecan", image:assets.home.tecanThumbnail, title:"Digital Visual Factory", descriptor:"Medtech Manufacturing / Tecan", copy:"Transforming paper-based assembly instructions into a clear, traceable production workflow.", class:"supporting" }
];
---
<MainLayout>
  <section class="shell landing-hero">
    <h1 class="display">Clarity starts in the weeds.</h1>
    <p>I’m Michelle, a product designer who likes to work alongside engineers and users to understand complex systems from the inside out—jamming, refining, and simplifying until the result feels clear and considered.</p>
  </section>

  <section id="work" class="work">
    <div class="section-label shell"><span>Selected work</span><i></i><span>2018—Now</span></div>
    <div class="project-grid">
      {projects.map((p) => (
        <a href={p.href} class={`project ${p.class}`}>
          <div class="thumbnail-wrap">
            <ProjectThumbnail
              src={p.image}
              alt={`${p.title} project thumbnail`}
              project={p.title}
              kind={p.kind}
            />
          </div>
          <div class="project-meta">
            <h2>{p.title}<span class="title-arrow" aria-hidden="true">↗</span></h2>
            <p>{p.descriptor}</p>
          </div>
          <p class="mobile-summary">{p.copy}</p>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
<style>
  .landing-hero{display:block;padding:4.5rem 0 6rem;max-width:1120px}
  .landing-hero h1{font-size:clamp(2.4rem,4vw,3.75rem);line-height:1.1;max-width:none;margin:0 0 1.25rem;white-space:nowrap}
  .landing-hero>p{font-size:1rem;line-height:1.55rem;margin:0;max-width:660px}
  .section-label{display:flex;align-items:center;gap:1rem;font-size:.76rem;font-weight:650;margin-bottom:2rem}.section-label i{height:1px;background:var(--line);flex:1}
  .work{width:min(1280px,calc(100% - 32px));margin-inline:auto}
  .section-label{width:min(1120px,calc(100% - 32px))}
  .project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3.25rem 1.25rem}
  .project{position:relative;text-decoration:none}
  .thumbnail-wrap{position:relative;overflow:hidden;border-radius:10px}
  .project-meta{display:flex;justify-content:space-between;gap:.75rem;align-items:center;padding-top:.75rem}
  .project-meta h2{margin:0;font:650 .82rem/1.2 var(--font-sans,Arial,sans-serif);letter-spacing:0}
  .project-meta p{margin:0;color:var(--muted);font-size:.72rem;line-height:1.05rem;text-align:right;opacity:0;transform:translateY(3px);transition:opacity .18s ease,transform .18s ease}
  .project:hover .project-meta p,.project:focus-visible .project-meta p{opacity:1;transform:translateY(0)}
  .title-arrow{display:inline-block;margin-left:.25rem;font-size:.82em;font-weight:500;transition:transform .18s ease}
  .project:hover .title-arrow,.project:focus-visible .title-arrow{transform:translate(2px,-2px)}
  .mobile-summary{display:none;margin:.7rem 0 0;font-size:.76rem;line-height:1.3rem;color:var(--muted)}
  .project:hover :global(.thumbnail){
    transform:translateY(-3px);
    background-color:var(--color-base-200);
    background-image:url("/assets/thumbnail-hover-bg.png");
    background-position:center;
    background-size:cover;
  }
  .project.featured :global(.thumbnail){aspect-ratio:4/3;padding:clamp(2rem,4vw,3.5rem)}
  .project.supporting :global(.thumbnail){aspect-ratio:16/10;padding:clamp(2rem,4vw,3.5rem)}
  @media(max-width:960px){.work{width:min(100% - 28px,1120px)}.section-label{width:100%}.project-grid{gap:2.75rem 1rem}}
  @media(max-width:720px){.landing-hero{padding:3rem 0 5rem}.landing-hero h1{font-size:2.7rem;white-space:normal}.project-grid{grid-template-columns:1fr;gap:3rem}.project.featured :global(.thumbnail),.project.supporting :global(.thumbnail){aspect-ratio:4/3}.mobile-summary{display:block}}
  @media(hover:none){.mobile-summary{display:block}}
</style>
