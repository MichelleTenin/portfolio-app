---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectThumbnail from "../components/ProjectThumbnail.astro";
import { assets } from "../data/assets";
const projects = [
  { href:"/aurora", kind:"aurora", image:assets.home.auroraThumbnail, title:"Aurora", descriptor:"Cancer survivorship support", tag:"User research", copy:"Bridging the gap between treatment and survivorship through a compassionate, hospital-based support system.", class:"wide" },
  { href:"/tecan", kind:"tecan", image:assets.home.tecanThumbnail, title:"Tecan", descriptor:"Digital visual factory", tag:"Usability testing", copy:"Transforming paper-based assembly instructions into a clear, traceable production workflow.", class:"" },
  { href:"/teststudio", kind:"teststudio", image:undefined, title:"Behavioral Testing", descriptor:"Autonomous vehicles at Nvidia", tag:"Developer experience", copy:"Building structure into behavioral testing for safety-critical autonomous vehicle systems.", class:"" },
  { href:"/mlloop", kind:"mlloop", image:undefined, title:"MLOps", descriptor:"Autonomous vehicles at Nvidia", tag:"Systems thinking", copy:"Aligning people, processes, and tools across the machine learning lifecycle.", class:"wide" }
];
---
<MainLayout>
  <section class="shell landing-hero">
    <h1 class="display">I design for clarity<br />in complex worlds.</h1>
    <p>I’m Michelle, a product designer working on complex, engineering-led systems for AI and machine learning. I turn unstructured workflows into cohesive experiences.</p>
  </section>

  <section id="work" class="shell work">
    <div class="section-label"><span>Selected work</span><i></i><span>2018—Now</span></div>
    <div class="project-grid">
      {projects.map((p) => (
        <a href={p.href} class={`project ${p.class}`}>
          <ProjectThumbnail
            src={p.image}
            alt={`${p.title} project thumbnail`}
            project={p.title}
          />
          <div class="project-meta">
            <div><h2>{p.title}</h2><p>{p.descriptor}</p></div>
            <span>{p.tag}</span>
          </div>
          <p class="summary">{p.copy}</p>
          <span class="view">View case study ↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell close">
    <div class="section-label"><span>A little about me</span><i></i></div>
    <div class="close-content">
      <p class="display">I use research, systems thinking, and hands-on prototyping to bring clarity to the messy middle of product development.</p>
      <a href="/about">More about me ↗</a>
    </div>
  </section>
</MainLayout>
<style>
  .landing-hero{display:block;padding:4.5rem 0 6rem;max-width:1120px}
  .landing-hero h1{font-size:clamp(2.4rem,4vw,3.75rem);line-height:1.1;max-width:720px;margin:0 0 1.25rem}
  .landing-hero>p{font-size:1rem;line-height:1.55rem;margin:0;max-width:660px}
  .section-label{display:flex;align-items:center;gap:1rem;font-size:.76rem;font-weight:650;margin-bottom:2rem}.section-label i{height:1px;background:var(--line);flex:1}
  .project-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem 1.25rem}
  .project{position:relative;text-decoration:none}.project.wide{grid-column:1/-1}
  .project-meta{display:flex;justify-content:space-between;gap:1rem;align-items:start;padding-top:.9rem}.project-meta h2{font:400 1.35rem Georgia,serif;margin:0 0 .15rem}.project-meta p,.summary{margin:0;color:var(--muted);font-size:.8rem}.project-meta>span{font-size:.68rem;border:1px solid var(--line);border-radius:99px;padding:.3rem .55rem;white-space:nowrap}
  .summary{font-size:.92rem;line-height:1.55;max-width:560px;margin-top:.8rem;color:var(--ink)}.view{display:inline-block;font-size:.77rem;font-weight:700;margin-top:1rem;text-decoration:underline;text-underline-offset:4px}
  .project:hover :global(.thumbnail){
    transform:translateY(-3px);
    background-color:var(--color-base-200);
    background-image:url("/assets/thumbnail-hover-bg.png");
    background-position:center;
    background-size:cover;
  }
  .close{margin-top:5rem;padding:0 0 1rem}.close .section-label{margin-bottom:1.25rem}.close-content{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem}.close .display{max-width:650px;margin:0;font-size:clamp(1.35rem,2vw,1.7rem);line-height:1.2}.close a{flex:none;font-size:.78rem;font-weight:650;text-underline-offset:4px}
  @media(max-width:720px){.landing-hero{padding:3rem 0 5rem}.landing-hero h1{font-size:2.7rem}.project-grid{grid-template-columns:1fr;gap:4rem}.project.wide{grid-column:auto}.close{margin-top:4rem}.close-content{align-items:flex-start;flex-direction:column;gap:1rem}}
</style>
