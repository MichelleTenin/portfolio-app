---
import CaseStudy from "../components/CaseStudy.astro";
import { assets } from "../data/assets";
const project = {
  number:"01", title:"Aurora", headline:"A support system for life after ovarian cancer treatment.", breadcrumb:"Cancer Survivorship Support / Design for America @ UW", kind:"aurora", cover:assets.aurora.cover, layout:"aurora", kicker:"UX design · Systems thinking", role:"Student designer", duration:"Oct 2018—May 2019",
  sections:[
    { id:"overview", label:"Context" },
    { id:"challenge", label:"Care cliff" },
    { id:"process", label:"Listening" },
    { id:"solution", label:"Support system" },
    { id:"reflection", label:"Outcome" },
  ],
  excerpt:"Completed during my freshman year at the University of Washington through the Design for America student organization, this project explored the transition into ovarian cancer survivorship. I planned and facilitated sensitive interviews with survivors, oncologists, and nurses, then translated three core needs—education, support, and connection—into a hospital-based support system.",
  challengeTitle:"The end of treatment can feel like the start of uncertainty.", challenge:"Survivors described feeling adrift once treatment ended—unsure where to find trustworthy information or emotional support. Clinicians worried about misinformation and the lack of structured post-treatment planning.",
  challengeMedia:assets.aurora.careCliff,
  approachTitle:"Sensitive conversations required deliberate preparation.", approach:"Because survivorship is personal and emotionally complex, the research plan used carefully sequenced scripts and facilitation techniques to create safety while guiding discussion toward actionable needs. Interviews with survivors, oncologists, and nurses revealed three priorities: education, support, and connection.",
  processQuotes:[
    { quote:"I spend a lot of time telling patients where not to look and what not to search.", attribution:"Oncologist interview" },
  ],
  principles:["Verified information","Flexible support","Peer connection"],
  processMedia:assets.aurora.process,
  solutionTitle:"A safe starting point for post-treatment recovery.",
  solution:"Aurora is a research and support kiosk placed on oncology floors. Its calm, private experience connects survivors with trustworthy information, relevant groups, and a network of peers at their own pace.",
  solutionFeatures:["Personalized onboarding and curated resources","Privacy controls for anonymous participation","Content organized around connection, education, and support","Printed take-home summaries for continued access"],
  solutionMedia:assets.aurora.storyboard,
  solutionMediaAlt:"Storyboard showing the Aurora kiosk experience",
  reflectionTitle:"The work moved beyond the classroom.",
  reflection:[
    "The project reinforced that rigorous research and deep empathy can coexist. Thoughtful scripts created space for honest conversation, while synthesis kept the team focused on actionable needs.",
    "The work concluded with a presentation of the research, system concept, and prototype at Artefact design studio in Seattle, Washington.",
  ],
  reflectionMedia:assets.aurora.reflection,
  next:"Tecan", nextHref:"/tecan"
};
---
<CaseStudy {project} />
