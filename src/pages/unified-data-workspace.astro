    .charts,.strategy-columns,.outcomes{grid-template-columns:1fr}.persona-list{grid-template-columns:1fr}
    .research-facts{gap:.75rem}.research-facts strong{font-size:1.4rem}
    .synthesis-card{padding:.85rem}.synthesis-visual{grid-template-columns:minmax(0,1fr) 26px minmax(0,1fr);gap:.4rem}.artifact-frame{padding:.3rem}.method-arrow{width:26px;height:26px}
